<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E65100"
    tools:context=".Home.pertemuan_11.TabCFragment">


    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="#36D889"
        android:contentDescription="Logo Android"
        android:padding="12dp"
        android:src="@drawable/ic_android_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.131" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="332dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:text="Mulai Gunakan Sekarang!"
        android:textColor="#263238"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="206dp" />

    <TextView
        android:layout_width="330dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Jelajahi fitur pesan dan temukan informasi penting dari komunitas pengguna."
        android:textColor="#37474F"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="300dp" />

</androidx.constraintlayout.widget.ConstraintLayout>